# IdentityShield environment. Copy to `.env` and replace every CHANGE_ME value.
# `scripts/init_env.sh` does this for you with freshly generated random secrets.
# Never commit the real `.env`.

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_owner            # table owner, used only for migrations
IS_APP_DB_PASSWORD=CHANGE_ME_app             # runtime role, subject to row-level security
KEYCLOAK_DB_PASSWORD=CHANGE_ME_kcdb

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis

# ---- Keycloak --------------------------------------------------------------
# Master-realm admin. Only the tenancy service (realm provisioning) uses it.
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_kcadmin

# ---- IdentityShield API ----------------------------------------------------
JWT_SECRET=CHANGE_ME_at_least_32_random_bytes
# 32 random bytes, base64 (encrypts per-tenant client secrets at rest)
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
INGEST_HMAC_SECRET=CHANGE_ME_ingest
PLATFORM_API_KEY=CHANGE_ME_platform

# Browser-facing origin of the dashboard (nginx proxies /api to the API)
PUBLIC_URL=http://localhost:5173
KEYCLOAK_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=true

# ---- Lab mode (simulator + headless demo). Never enable in production. -----
LAB_MODE=true
LAB_API_KEY=CHANGE_ME_lab
# Password given to seeded demo users (lab only)
DEMO_PASSWORD=CHANGE_ME_demo_Passw0rd!
